# Storet Supabase configuration
# Copy this file to .env.local and fill in your Supabase project values.
# Create React App only exposes variables that start with REACT_APP_.

REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional fallback if your Supabase dashboard still labels the key as an anon key.
# REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Storet map/address search configuration
# Use a public Mapbox token. This is browser-visible, so restrict it by URL in Mapbox before deployment.
REACT_APP_MAPBOX_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN